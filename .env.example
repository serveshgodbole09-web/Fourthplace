# Copy to backend/.env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL=sqlite:///./database/fourth_place.db

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Twilio SMS (never commit real credentials) ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15005550006

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# Optional: place query for the embed + directions
CAFE_MAP_QUERY=Cafe Fourth Place, Shaniwar Peth, Rajmachi, Guruwar Peth, Satara, Maharashtra 415001
CAFE_LAT=12.9716
CAFE_LNG=77.5946

# --- Demo admin (used only by seed script) ---
ADMIN_EMAIL=admin@fourthplace.cafe
ADMIN_PASSWORD=fourthplace-admin
